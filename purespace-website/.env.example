# Copy the lines you need into your server's environment (systemd unit, hosting panel, etc.).
# Nothing here is required for local testing - sensible defaults are used.

# Long random string. If unset, one is generated and kept in instance/secret_key.
# Generate:  python -c "import secrets; print(secrets.token_hex(32))"
PURESPACE_SECRET_KEY=

# Where the SQLite database lives (default: instance/purespace.sqlite3)
PURESPACE_DATABASE=

# Set to 1 once the site is served over HTTPS (secure cookies + HSTS)
PURESPACE_SECURE_COOKIES=0

# Set to 1 when running behind nginx/Apache/a hosting proxy so client IPs are read correctly
PURESPACE_TRUST_PROXY=0

# Sign admins out after this many idle minutes
PURESPACE_ADMIN_IDLE_MINUTES=60

# Optional email alerts for new enquiries (leave SMTP_HOST empty to switch off)
PURESPACE_SMTP_HOST=
PURESPACE_SMTP_PORT=587
PURESPACE_SMTP_USER=
PURESPACE_SMTP_PASSWORD=
PURESPACE_SMTP_TLS=1
PURESPACE_MAIL_FROM=
PURESPACE_NOTIFY_EMAIL=
PURESPACE_SEND_CUSTOMER_CONFIRMATION=0
